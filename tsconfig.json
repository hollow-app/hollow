{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "baseUrl": "./src",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@app/*": [
        "App/*"
      ],
      "@selector/*": [
        "Selector/*"
      ],
      "@coretools/*": [
        "App/(Core Tools)/*"
      ],
      "@styles/*": [
        "styles/*"
      ],
      "@rust": [
        "lib/rust"
      ],
      "@lib": [
        "lib"
      ],
      "@ui":[
	      "components/ui/index.ts"
      ],
      "@component/*":[
	      "components/*"
      ],
      "@overlays/*":[
	      "overlays/*"
      ],
        "@hollow/center": [
                "/home/ryu/hub/hollow-center/src/index.ts"
            ]

    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
